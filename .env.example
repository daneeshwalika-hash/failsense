# Copy to .env (git-ignored) to change the defaults of `docker compose up`. No secrets belong here.

# Where the API reaches the Ollama server for the German maintenance report.
# Ollama runs on the HOST (not in compose); containers use host.docker.internal.
# On Windows, Ollama listens on 127.0.0.1 only by default: set OLLAMA_HOST=0.0.0.0 for the Ollama
# process (and allow the Windows firewall prompt) or the API cannot reach it and uses the
# template report instead. Without Ollama at all the template report is used as well.
OLLAMA_BASE_URL=http://host.docker.internal:11434
